{
  "name": "archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start:local": "pnpm build && wrangler dev --local --config dist/server/wrangler.json --name archive-production",
    "check:vinext": "vinext check",
    "types:generate": "wrangler types worker-configuration.d.ts",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --config oxlint.json .",
    "format": "prettier --write src test scripts package.json pnpm-workspace.yaml tsconfig.json vite.config.ts vitest.config.ts vitest.ui.config.ts vitest.worker.config.ts next.config.ts next-env.d.ts oxlint.json wrangler.jsonc README.md docs/ARCHITECTURE.md",
    "format:check": "prettier --check src test scripts package.json pnpm-workspace.yaml tsconfig.json vite.config.ts vitest.config.ts vitest.ui.config.ts vitest.worker.config.ts next.config.ts next-env.d.ts oxlint.json wrangler.jsonc README.md docs/ARCHITECTURE.md",
    "test:ui": "vitest run --project ui",
    "test:worker": "pnpm build && vitest run --project worker",
    "test": "pnpm build && vitest run",
    "quality": "pnpm build && pnpm types:check && pnpm typecheck && pnpm lint && pnpm format:check && vitest run",
    "release:status": "pnpm build && node scripts/release.mjs status",
    "release:bootstrap": "pnpm build && node scripts/release.mjs bootstrap",
    "release:candidate": "pnpm build && node scripts/release.mjs candidate",
    "release:promote": "node scripts/release.mjs promote",
    "release:rollback": "node scripts/release.mjs rollback",
    "release:pipeline": "pnpm build && node scripts/release.mjs pipeline",
    "release:verify": "node scripts/release.mjs verify"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "server-only": "0.0.1",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/vitest-plugin": "1.1.10",
    "@msw/cloudflare": "0.0.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.0.0",
    "vitest": "4.1.0",
    "wrangler": "4.132.0"
  }
}
